# Copy this file to .env and fill in values as needed. Loaded automatically
# via `dotenv/config` at the top of server.js. None of these are required to
# run the app locally — every one has a safe default or a no-op fallback.

# Port the Express server listens on.
PORT=3001

# Origin the backend's CORS policy allows for credentialed requests — the
# deployed frontend's URL (e.g. https://your-app.vercel.app in production).
# Falls back to the local Vite dev server if unset.
CLIENT_ORIGIN=http://localhost:5173

# Signing secret for issued JWTs (see middleware/auth.js). Falls back to a
# hardcoded dev secret if unset — that default is fine for local dev, but
# MUST be overridden with a long random value in any shared/production
# environment, since anyone who knows the default can forge tokens.
JWT_SECRET=

# Read-through cache for hot per-request recommender lookups (track
# metadata, per-user genre/artist affinity scores) — see
# backend/services/cache.js and ARCHITECTURE.md. Optional: when unset, the
# L2 tier no-ops to a direct SQLite read, so local dev and the test suite
# work fine without a running Redis. Set this to exercise the cache for
# real, e.g. after `brew install redis && brew services start redis`:
REDIS_URL=redis://localhost:6379

# Overrides where the SQLite database file lives. Mainly used by
# test/setup.js to point the test run at a throwaway file so tests can
# never touch or corrupt the real backend/music_swipe.db — you shouldn't
# normally need to set this yourself locally. In production (e.g. Fly.io),
# point this at a mounted persistent volume so data survives redeploys:
#   MUSIC_SWIPE_DB=/data/music_swipe.db
MUSIC_SWIPE_DB=
