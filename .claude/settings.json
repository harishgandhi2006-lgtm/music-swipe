{
  "bash": {
    "deniedCommands": [
      "rm -rf",
      "DROP TABLE",
      "truncate"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npm run test --if-present"
          }
        ]
      }
    ]
  }
}
